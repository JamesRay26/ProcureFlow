// Week 7 Backend & Database Lead Audit Compliance Schema
// CS 490 Senior Capstone

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Organization {
  id             String          @id @default(uuid())
  name           String          @unique
  createdAt      DateTime        @default(now())
  members        User[]
  invitations    Invitation[]
  inventoryItems InventoryItem[]
  requests       Request[]
  auditLogs      AuditLog[]
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  passwordHash   String        
  name           String
  role           String        // ADMIN, PROCUREMENT_MANAGER, WAREHOUSE_STAFF, AUDITOR
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  requests       Request[]     @relation("RequestsCreated")
  auditLogs      AuditLog[]

  // Week 7 Checklist: Strategic B-Tree Indexing on Foreign Keys
  @@index([organizationId])
}

model Invitation {
  id             String       @id @default(uuid())
  email          String
  role           String
  token          String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  expiresAt      DateTime

  // Week 7 Checklist: Strategic B-Tree Indexing on Foreign Keys
  @@index([organizationId])
}

model InventoryItem {
  id             String       @id @default(uuid())
  sku            String
  name           String
  category       String
  stock          Int          @default(0)
  maxStock       Int          @default(100)
  threshold      Int          @default(10)
  warehouse      String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  requests       Request[]
  
  @@unique([sku, organizationId])
  // Week 7 Checklist: Strategic B-Tree Indexing & Left-Prefix Compound Index
  @@index([organizationId])
  @@index([organizationId, stock])
}

model Request {
  id             String        @id @default(uuid())
  quantity       Int
  priority       String        // Low, Medium, High
  justification  String?
  status         String        @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt      DateTime      @default(now())
  
  // Tracking & Shipping
  shippingStatus String?       // PREPARING, SHIPPED, IN_TRANSIT, DELIVERED
  estimatedArrival DateTime?
  latitude       Float?
  longitude      Float?
  
  // Relations
  itemId         String
  item           InventoryItem @relation(fields: [itemId], references: [id])
  
  requestedById  String
  requestedBy    User          @relation("RequestsCreated", fields: [requestedById], references: [id])
  
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  // Week 7 Checklist: Strategic B-Tree Indexing on Foreign Keys & Left-Prefix Compound Index
  @@index([organizationId])
  @@index([itemId])
  @@index([requestedById])
  @@index([organizationId, status])
}

model AuditLog {
  id             String       @id @default(uuid())
  actionType     String       // CREATION, APPROVAL, REJECTION, ROLE_CHANGE
  description    String
  ipAddress      String?
  requestId      String?
  createdAt      DateTime     @default(now())
  
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Week 7 Checklist: Strategic B-Tree Indexing on Foreign Keys
  @@index([organizationId])
  @@index([userId])
  @@index([requestId])
}
